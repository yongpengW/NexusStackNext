<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NexusStackNext.Composition</RootNamespace>
    <AssemblyName>NexusStackNext.Composition</AssemblyName>
  </PropertyGroup>

  <!--
    宿主组装专用：日志、配置中心，以及三个独立入口共用的 Identity HTTP 会话适配器。

    **只允许宿主引用本工程**（PlatformHost、Gateway、CostingHost、PricingHost）。
    Domain / Application / Infrastructure 一律不得引用它——那三层与"进程怎么起"无关，
    而这里是进程装配与出站 HTTP 配置，不拥有任何上下文的表或领域规则。

    它也不是"隐藏的组装"（不变量 8 禁止的那种）：宿主仍然逐行声明自己由什么组成，
    这里只收实际被多个宿主证明需要的共同适配器。任何随宿主不同的东西
    （健康检查、路由、存储根目录）都留在各宿主自己的 Program.cs 里。
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../BuildingBlocks/BuildingBlocks.Web/BuildingBlocks.Web.csproj" />
    <ProjectReference Include="../../Services/Identity/NexusStackNext.Identity.Contracts/NexusStackNext.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <!-- 让配置里的 Enrich: [WithSpan, WithThreadId, WithThreadName] 能解析——
         少了这两个包，ReadFrom.Configuration 会在**启动时**抛"找不到 enricher"。 -->
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="AgileConfig.Client" />
  </ItemGroup>

</Project>
