{
  "routes": [
    {
      "routeId": "auditing-exports",
      "clusterId": "platform-host",
      "path": "/api/auditing/exports/{**catch-all}",
      "methods": [ "GET", "POST" ],
      "timeout": "00:00:35",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "platform-audit-retry",
      "clusterId": "platform-host",
      "path": "/api/platform/audit-deliveries/{messageId}/retry",
      "methods": [ "POST" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "auditing-investigation",
      "clusterId": "platform-host",
      "path": "/api/auditing/entries",
      "methods": [ "GET" ],
      "timeout": "00:00:05",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "auditing-operations",
      "clusterId": "platform-host",
      "path": "/api/auditing/operations",
      "methods": [ "GET" ],
      "timeout": "00:00:05",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "auditing-capacity",
      "clusterId": "platform-host",
      "path": "/api/auditing/capacity",
      "methods": [ "GET" ],
      "timeout": "00:00:05",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "platform-read",
      "clusterId": "platform-host",
      "path": "/api/platform/{**catch-all}",
      "methods": [ "GET" ],
      "transforms": [
        { "ResponseHeader": "X-Gateway", "Set": "nexusstack" }
      ],
      "timeout": "00:00:05",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "platform-write",
      "clusterId": "platform-host",
      "path": "/api/platform/{**catch-all}",
      "methods": [ "PUT", "DELETE" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "identity-info",
      "clusterId": "platform-host",
      "path": "/api/identity",
      "methods": [ "GET" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": false
    },
    {
      "routeId": "identity-management",
      "clusterId": "platform-host",
      "path": "/api/identity/{**catch-all}",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "identity-login",
      "clusterId": "platform-host",
      "path": "/api/identity/login",
      "methods": [ "POST" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": false
    },
    {
      "routeId": "identity-refresh",
      "clusterId": "platform-host",
      "path": "/api/identity/refresh",
      "methods": [ "POST" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": false
    },
    {
      "routeId": "identity-self-register",
      "clusterId": "platform-host",
      "path": "/api/identity/users",
      "methods": [ "POST" ],
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": false
    },
    {
      "routeId": "scheduling-info",
      "clusterId": "platform-host",
