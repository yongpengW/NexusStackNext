      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": false
    },
    {
      "routeId": "scheduling-management",
      "clusterId": "platform-host",
      "path": "/api/scheduling/{**catch-all}",
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
    },
    {
      "routeId": "files-api",
      "clusterId": "platform-host",
      "path": "/api/files/{**catch-all}",
      "maxRequestBodySize": 67108864,
      "rateLimitPolicy": "gateway.default",
      "requireAuthentication": true
