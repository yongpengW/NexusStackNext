{
  "$schema": "https://json.schemastore.org/template",
  "author": "Leo Wang",
  "classifications": [ "Web", "API", "Microservices", "DDD" ],
  "identity": "NexusStackNext.Solution.Template",
  "name": "NexusStackNext - DDD Microservices Solution",
  "shortName": "nexusstack-next",
  "description": "面向领域的 .NET 微服务解决方案模板：五个平台上下文、独立成本与定价任务样板、事务 Outbox/Inbox 跨服务协作、默认拒绝的授权、以及把架构不变量变成断言的在仓测试。",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "NexusStackNext",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "NexusStackNext.slnx"
    }
  ],
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/.git/**",
            "**/.idea/**",
            "**/*.user",
            "**/*.suo",
            "**/.template.config/**",

            "**/.scratch/**",

            "**/*.nupkg",
            "**/agile/**",
            "**/*.cache",
            "**/*.serviceid",
            "**/appsettings.*.local.json",
            "**/env/*.dev",
            "**/*.pfx"
          ]
        }
      ]
    }
  ],
  "postActions": [
    {
      "description": "还原 NuGet 包",
      "manualInstructions": [
        {
          "text": "运行 dotnet restore"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false
    },
    {
      "description": "整理改名后的 C# 导入与格式",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "format --no-restore",
        "redirectStandardOutput": false,
        "redirectStandardError": false
      },
      "manualInstructions": [
        {
          "text": "在生成目录运行 dotnet restore，然后运行 dotnet format --no-restore"
        }
      ],
      "continueOnError": false
    }
  ]
}
